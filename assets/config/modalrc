keysection "Undo, repeat and macros"
nmap u          undo              "Undo"
nmap <C-r>      redo              "Redo"
nmap .          repeat            "Repeat the last change"
nmap Q          macro-record      "Record a macro"
nmap @          macro-play        "Play a macro"

