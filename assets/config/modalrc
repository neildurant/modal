" Modal's built-in command file: the default key bindings. It runs first, then modalrc in
" your config directory, which can change any of it. modal --write-config FILE writes every
" setting, binding and colour there is, to start from.

" Moving the cursor
nmap h          cursor-left       "Left"
nmap <Left>     cursor-left       "Left"
nmap j          cursor-down       "Down"
nmap <Down>     cursor-down       "Down"
nmap k          cursor-up         "Up"
nmap <Up>       cursor-up         "Up"
nmap l          cursor-right      "Right"
nmap <Right>    cursor-right      "Right"
nmap 0          cursor-first      "First field"
nmap <Home>     cursor-first      "First field"
nmap $          cursor-last       "Last field"
nmap <End>      cursor-last       "Last field"
nmap gg         go-first          "First event, or bar {count}"
nmap G          go-last           "End, or bar {count}"

" Moving in time, to the event at or after where each lands, in the track's bars: a beat, the
" same place a bar on, a bar line, a chord (events starting within chordwindow of each
" other), a section's start, a marker
nmap w          cursor-beat-next          "Next beat"
nmap b          cursor-beat-previous      "Beat before"
nmap }          cursor-bar-next           "Same place, next bar"
nmap {          cursor-bar-previous       "Same place, bar before"
nmap ]]         cursor-bar-line-next      "Next bar line"
nmap [[         cursor-bar-line-previous  "Bar line before"
nmap )          cursor-chord-next         "Next chord"
nmap (          cursor-chord-previous     "Chord before"
nmap ]s         cursor-section-next       "Next section"
nmap [s         cursor-section-previous   "Section before"
nmap ]m         cursor-marker-next        "Next marker"
nmap [m         cursor-marker-previous    "Marker before"

" Changing events: Enter edits the field under the cursor, typing a value or a change such
" as +10 or +1/16 (Enter sets it, Escape leaves it); + and - (or Ctrl-A and Ctrl-X) step it,
" with counts. d and y take a motion (d} up to where } goes, dj this event and the next),
" or dd and yy this event; x deletes it, p puts what was yanked or deleted at the cursor's
" time, and u and Ctrl-R undo and redo
nmap <CR>       field-edit        "Edit this field"
nmap +          field-increase    "Step up"
nmap <C-a>      field-increase    "Step up"
nmap -          field-decrease    "Step down"
nmap <C-x>      field-decrease    "Step down"
nmap d          operator-delete   "Delete"
nmap y          operator-yank     "Yank"
nmap x          event-delete      "Delete this event"
nmap p          register-put      "Put"
nmap o          note-add          "Add a note"
nmap u          undo              "Undo"
nmap <C-r>      redo              "Redo"

" Tracks: the conductor's list is track 0, before track 1
nmap gt         track-next        "Next track, or track {count}"
nmap gT         track-previous    "Track before"

" Scrolling. Ctrl with a direction moves the cursor and scrolls with it, so it stays in
" place on screen, until the view can't scroll further.
nmap <C-h>      cursor-left-scroll  "Left, scrolling"
nmap <C-Left>   cursor-left-scroll  "Left, scrolling"
nmap <C-j>      cursor-down-scroll  "Down, scrolling"
nmap <C-Down>   cursor-down-scroll  "Down, scrolling"
nmap <C-k>      cursor-up-scroll    "Up, scrolling"
nmap <C-Up>     cursor-up-scroll    "Up, scrolling"
nmap <C-l>      cursor-right-scroll "Right, scrolling"
nmap <C-Right>  cursor-right-scroll "Right, scrolling"
nmap <C-d>      scroll-half-down  "Half a page down"
nmap <C-u>      scroll-half-up    "Half a page up"
nmap <C-f>      scroll-page-down  "A page down"
nmap <PageDown> scroll-page-down  "A page down"
nmap <C-b>      scroll-page-up    "A page up"
nmap <PageUp>   scroll-page-up    "A page up"
nmap zz         scroll-centre     "Centre the cursor"

" Text size: Ctrl with plus, minus or 0, on the keyboard or the keypad. Plus is shifted on
" most keyboards, so Ctrl-= and Ctrl-Shift-= are bound too.
nmap <C-=>      font-bigger       "Bigger text"
nmap <C-S-=>    font-bigger       "Bigger text"
nmap <C-+>      font-bigger       "Bigger text"
nmap <C-kPlus>  font-bigger       "Bigger text"
nmap <C-->      font-smaller      "Smaller text"
nmap <C-kMinus> font-smaller      "Smaller text"
nmap <C-0>      font-reset        "Text size from the config"
nmap <C-k0>     font-reset        "Text size from the config"

" The command line: : opens it, and in it these keys edit, run and recall lines. Other
" characters are typed.
nmap :          command-line            "Command line"
cmap <CR>       command-line-run        "Run"
cmap <Esc>      command-line-cancel     "Cancel"
cmap <BS>       command-line-backspace  "Delete back"
cmap <Del>      command-line-delete     "Delete"
cmap <Left>     command-line-left       "Left"
cmap <Right>    command-line-right      "Right"
cmap <Home>     command-line-start      "Start"
cmap <End>      command-line-end        "End"
cmap <C-u>      command-line-clear      "Clear"
cmap <Up>       command-line-older      "Older line"
cmap <Down>     command-line-newer      "Newer line"

nmap <Esc>      cancel            "Cancel"
